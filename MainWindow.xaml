<Window x:Class="NetAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetAnalyzer"
        Title="j0kers Network Analyzer" Height="660" Width="940"
        MinHeight="320" MinWidth="720"
        Background="Transparent"
        FontFamily="Segoe UI" TextElement.Foreground="{StaticResource Fg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Opacity="{Binding WindowOpacity}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize">

    <!--
        AllowsTransparency is what makes the window layered, and only a layered window can
        actually be seen through — without it WPF just fades the content against its own
        background, which reads as a dimmer window rather than a translucent one. It requires
        WindowStyle=None, so the title bar below is ours rather than the system's. WindowChrome
        restores the parts that come with a real frame: edge resizing, snap, and a maximize that
        respects the taskbar.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:EnumVisibilityConverter x:Key="ModeVis"/>
        <local:ValueEqualsConverter x:Key="ValueEquals"/>

        <!--
            Shown on hover over any meter. Bound to the singleton rather than a DataContext,
            because a tooltip lives in its own popup outside the window's tree.
        -->
        <!-- x:Shared=False: a ToolTip instance cannot be the child of several owners at once. -->
        <ToolTip x:Key="TopTalkersTip" x:Shared="False" MaxWidth="330">
            <StackPanel MinWidth="260">
                <TextBlock Text="Top bandwidth consumers" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Text="{Binding Source={x:Static local:TopTalkers.Instance}, Path=Scope}"
                           FontSize="10" Foreground="{StaticResource FgDim}" Margin="0,1,0,7"/>

                <TextBlock Text="{Binding Source={x:Static local:TopTalkers.Instance}, Path=Status}"
                           FontSize="11" Foreground="{StaticResource FgDim}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static local:TopTalkers.Instance}, Path=Status}"
                                             Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Source={x:Static local:TopTalkers.Instance}, Path=Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="11"
                                           Foreground="#3AD17E" TextAlignment="Right" MinWidth="74">
                                    <Run Text="↓"/><Run Text="{Binding DownText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="11"
                                           Foreground="#3AC6E8" TextAlignment="Right" MinWidth="74">
                                    <Run Text="↑"/><Run Text="{Binding UpText, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ToolTip>

        <!-- Compact row for widget mode: name, ribbon, and the two rates. -->
        <DataTemplate x:Key="WidgetTemplate" DataType="{x:Type local:InterfaceMeter}">
            <Grid Margin="0,0,0,5"
                  Background="Transparent"
                  ToolTip="{StaticResource TopTalkersTip}"
                  ToolTipOpening="Meter_ToolTipOpening"
                  ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="60000"
                  Visibility="{Binding ShowActivity, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="86"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,0,8,0" ToolTip="{Binding Description}"/>

                <local:StreamGraph Grid.Column="1" Height="30"
                                   PixelsPerSecond="{Binding DataContext.StreamSpeed,
                                       RelativeSource={RelativeSource AncestorType=Window}}"
                                   InLevel="{Binding InLevel, Mode=OneWay}"
                                   OutLevel="{Binding OutLevel, Mode=OneWay}"/>

                <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding InRateText, Mode=OneWay}" FontFamily="Consolas"
                               FontSize="11" TextAlignment="Right" Foreground="#3AD17E"/>
                    <TextBlock Text="{Binding OutRateText, Mode=OneWay}" FontFamily="Consolas"
                               FontSize="11" TextAlignment="Right" Foreground="#3AC6E8"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One card per network interface. -->
        <DataTemplate x:Key="InterfaceTemplate" DataType="{x:Type local:InterfaceMeter}">
            <!--
                Rows 0 and 2 are fixed-height insertion markers for drag reordering. They are
                always present so showing one never shifts the layout.
            -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="2" Background="Transparent">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DropHint}" Value="Above">
                                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Grid.Row="2" CornerRadius="2" Background="Transparent">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DropHint}" Value="Below">
                                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

            <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="6"
                    Margin="0,0,0,4" BorderBrush="#262D38" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Padding" Value="14,11"/>
                        <Style.Triggers>
                            <!-- Collapsed cards shed most of their padding to pack in tightly. -->
                            <DataTrigger Binding="{Binding ShowActivity}" Value="False">
                                <Setter Property="Padding" Value="9,3"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Activity switch: off collapses this card to its header line -->
                    <CheckBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                              IsChecked="{Binding ShowActivity, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              ToolTip="Show or hide the activity view for this interface">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource BigCheckBox}">
                                <Setter Property="Width" Value="26"/>
                                <Setter Property="Height" Value="26"/>
                                <Setter Property="FontSize" Value="17"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowActivity}" Value="False">
                                        <Setter Property="Width" Value="17"/>
                                        <Setter Property="Height" Value="17"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>

                    <!-- Header: adapter identity and link info -->
                    <DockPanel Grid.Column="1" Grid.Row="0">
                        <!-- Link detail is the first thing to go when the card collapses. -->
                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource FgDim}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding ShowActivity, Converter={StaticResource BoolToVis}}">
                            <Run Text="{Binding InterfaceType, Mode=OneWay}"/>
                            <Run Text="·"/>
                            <Run Text="{Binding LinkSpeedText, Mode=OneWay}"/>
                            <Run Text="·"/>
                            <Run Text="{Binding ScaleText, Mode=OneWay}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#3AD17E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUp}" Value="False">
                                                <Setter Property="Fill" Value="#5A6472"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowActivity}" Value="False">
                                                <Setter Property="FontSize" Value="11.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Description}" FontSize="11" Margin="9,0,0,0"
                                       Foreground="{StaticResource FgDim}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="320"
                                       Visibility="{Binding ShowActivity, Converter={StaticResource BoolToVis}}"/>
                            <!-- Stands in for the meters while the card is collapsed -->
                            <TextBlock Text="{Binding SummaryText, Mode=OneWay}" Margin="14,0,0,0"
                                       FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                                       Visibility="{Binding ShowActivity, Converter={StaticResource BoolToVis},
                                           ConverterParameter=invert}"/>
                        </StackPanel>
                    </DockPanel>

                    <!--
                        Rows 1 and 2 carry inbound and outbound. In bar mode each row holds its own
                        spectrum bar; in stream mode the bars collapse and a single ribbon spans
                        both rows in the same column, so labels and readouts stay put either way.
                    -->
                    <Grid Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Margin="0,9,0,0"
                          Background="Transparent"
                          ToolTip="{StaticResource TopTalkersTip}"
                          ToolTipOpening="Meter_ToolTipOpening"
                          ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="60000"
                          Visibility="{Binding ShowActivity, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="82"/>
                        </Grid.ColumnDefinitions>

                        <!-- Inbound -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="IN" FontSize="11" FontWeight="Bold"
                                   Foreground="#3AD17E" VerticalAlignment="Center"/>
                        <local:SpectrumBar Grid.Row="0" Grid.Column="1" Height="18" Palette="Inbound"
                                           Margin="0,0,0,5"
                                           Level="{Binding InLevel, Mode=OneWay}"
                                           Peak="{Binding InPeak, Mode=OneWay}"
                                           Visibility="{Binding DataContext.Mode,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource ModeVis},
                                               ConverterParameter=Bars}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding InRateText, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding TotalInText, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="11" TextAlignment="Right"
                                   Foreground="{StaticResource FgDim}" VerticalAlignment="Center"
                                   ToolTip="Total received since this app started"/>

                        <!-- Outbound -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="OUT" FontSize="11" FontWeight="Bold"
                                   Foreground="#3AC6E8" VerticalAlignment="Center"/>
                        <local:SpectrumBar Grid.Row="1" Grid.Column="1" Height="18" Palette="Outbound"
                                           Level="{Binding OutLevel, Mode=OneWay}"
                                           Peak="{Binding OutPeak, Mode=OneWay}"
                                           Visibility="{Binding DataContext.Mode,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource ModeVis},
                                               ConverterParameter=Bars}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OutRateText, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding TotalOutText, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="11" TextAlignment="Right"
                                   Foreground="{StaticResource FgDim}" VerticalAlignment="Center"
                                   ToolTip="Total sent since this app started"/>

                        <!-- Stream view: one ribbon, inbound above the spine, outbound below -->
                        <local:StreamGraph Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                           MinHeight="58" Margin="0,1,0,2"
                                           PixelsPerSecond="{Binding DataContext.StreamSpeed,
                                               RelativeSource={RelativeSource AncestorType=Window}}"
                                           InLevel="{Binding InLevel, Mode=OneWay}"
                                           OutLevel="{Binding OutLevel, Mode=OneWay}"
                                           Visibility="{Binding DataContext.Mode,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource ModeVis},
                                               ConverterParameter=Stream}"/>
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!--
        Right-click anywhere on the window. Reachable in widget mode too, where there is no
        title bar and no menu strip.
    -->
    <Window.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
            <MenuItem Header="Always on top" IsCheckable="True"
                      IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"/>
            <!--
                Checked state is read from the Run key each time the menu opens rather than
                bound: the registry is the source of truth and can change behind our back
                (Task Manager's Startup apps page edits the same entry).
            -->
            <MenuItem x:Name="StartupMenuItem" Header="Start with Windows"
                      Click="StartupMenuItem_Click"
                      ToolTip="Launch automatically when you sign in"/>
            <Separator/>
            <MenuItem Header="Opacity">
                <!--
                    Radio behaviour: the tick follows the stored value rather than toggling
                    locally, so exactly one option is ever marked.
                -->
                <MenuItem Header="100%" Tag="1.0" Click="Opacity_Click"
                          IsChecked="{Binding WindowOpacity, Mode=OneWay,
                              Converter={StaticResource ValueEquals}, ConverterParameter=1.0}"/>
                <MenuItem Header="90%" Tag="0.9" Click="Opacity_Click"
                          IsChecked="{Binding WindowOpacity, Mode=OneWay,
                              Converter={StaticResource ValueEquals}, ConverterParameter=0.9}"/>
                <MenuItem Header="80%" Tag="0.8" Click="Opacity_Click"
                          IsChecked="{Binding WindowOpacity, Mode=OneWay,
                              Converter={StaticResource ValueEquals}, ConverterParameter=0.8}"/>
                <MenuItem Header="65%" Tag="0.65" Click="Opacity_Click"
                          IsChecked="{Binding WindowOpacity, Mode=OneWay,
                              Converter={StaticResource ValueEquals}, ConverterParameter=0.65}"/>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Rounded shell standing in for the system frame; squared off when maximized. -->
    <Border x:Name="Shell" Background="{StaticResource Bg}" BorderBrush="#3C4657" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            Menu bar. Like the toolbar and footer below, its empty space doubles as a drag
            handle: with no system title bar, people grab whatever strip is nearest the top.
            Interactive controls mark their mouse-downs handled, so only the gaps drag.
        -->
        <Border Grid.Row="0" Background="#171C24" Padding="6,2"
                PreviewMouseLeftButtonDown="MenuBar_PreviewMouseLeftButtonDown"
                Visibility="{Binding Mode, Converter={StaticResource ModeVis}, ConverterParameter=!Widget}">
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="Always on top" IsCheckable="True"
                              IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                              ToolTip="Keep the window above other applications"/>
                    <Separator/>
                    <MenuItem Header="Minimize when closed" IsCheckable="True"
                              IsChecked="{Binding MinimizeOnClose, Mode=TwoWay}"
                              ToolTip="Closing the window sends it to the taskbar instead of exiting"/>
                    <MenuItem Header="Minimize to system tray" IsCheckable="True"
                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                              ToolTip="Hide into the notification area instead of the taskbar"/>
                    <Separator/>
                    <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="ExitMenu_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- Banner, doubling as the title bar: drag to move, double-click to maximize -->
        <Border Grid.Row="1" Padding="16,11" BorderBrush="#2C3440" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Visibility="{Binding Mode, Converter={StaticResource ModeVis}, ConverterParameter=!Widget}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#16202B" Offset="0"/>
                    <GradientStop Color="#12303F" Offset="0.55"/>
                    <GradientStop Color="#12151A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <!-- Caption buttons: this window has no system frame of its own -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                            Margin="8,-6,-8,0">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                           Margin="0,0,12,0" Foreground="{StaticResource FgDim}"
                           Text="live interface throughput"/>
                <StackPanel Orientation="Horizontal">
                    <!-- Hub-and-spoke mark, matching the application icon -->
                    <Canvas Width="24" Height="22" VerticalAlignment="Center" Margin="0,0,11,0">
                        <Line X1="12" Y1="11" X2="3" Y2="4" Stroke="#4EC9F5" StrokeThickness="1.6"/>
                        <Line X1="12" Y1="11" X2="21" Y2="4" Stroke="#4EC9F5" StrokeThickness="1.6"/>
                        <Line X1="12" Y1="11" X2="3" Y2="18" Stroke="#4EC9F5" StrokeThickness="1.6"/>
                        <Line X1="12" Y1="11" X2="21" Y2="18" Stroke="#4EC9F5" StrokeThickness="1.6"/>
                        <Ellipse Canvas.Left="0" Canvas.Top="1" Width="6" Height="6" Fill="#3AD17E"/>
                        <Ellipse Canvas.Left="18" Canvas.Top="1" Width="6" Height="6" Fill="#E8C44A"/>
                        <Ellipse Canvas.Left="0" Canvas.Top="15" Width="6" Height="6" Fill="#4EC9F5"/>
                        <Ellipse Canvas.Left="18" Canvas.Top="15" Width="6" Height="6" Fill="#F24E4E"/>
                        <Ellipse Canvas.Left="6" Canvas.Top="5" Width="12" Height="12" Fill="#EBF7FF"/>
                        <Ellipse Canvas.Left="9" Canvas.Top="8" Width="6" Height="6" Fill="#4EC9F5"/>
                    </Canvas>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="j0kers" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                        <Run Text="Network Analyzer" FontSize="19" FontWeight="Light"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="2" Background="{StaticResource PanelAlt}" Padding="14,10"
                BorderBrush="#2C3440" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Visibility="{Binding Mode, Converter={StaticResource ModeVis}, ConverterParameter=!Widget}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Poll every" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="IntervalSlider" Width="190" Minimum="100" Maximum="5000"
                        TickFrequency="100" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        Value="{Binding IntervalMs, Mode=TwoWay}"/>
                <TextBox x:Name="IntervalBox" Width="62" Margin="10,0,4,0" VerticalAlignment="Center"
                         Background="#151A21" Foreground="{StaticResource Fg}" BorderBrush="#38414F"
                         TextAlignment="Right"
                         Text="{Binding IntervalMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         KeyDown="IntervalBox_KeyDown"/>
                <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,18,0"
                           Foreground="{StaticResource FgDim}"/>

                <CheckBox Content="Bits/sec" VerticalAlignment="Center" Margin="0,0,14,0"
                          IsChecked="{Binding UseBits, Mode=TwoWay}"
                          ToolTip="Show Mbps instead of MB/s"/>
                <CheckBox Content="Inactive adapters" VerticalAlignment="Center" Margin="0,0,14,0"
                          IsChecked="{Binding ShowInactive, Mode=TwoWay}"/>
                <CheckBox Content="Loopback" VerticalAlignment="Center" Margin="0,0,14,0"
                          IsChecked="{Binding ShowLoopback, Mode=TwoWay}"/>
                <CheckBox Content="Hide filter adapters" VerticalAlignment="Center" Margin="0,0,18,0"
                          IsChecked="{Binding HideFilterAdapters, Mode=TwoWay}"
                          ToolTip="Hide the WFP/QoS filter entries Windows stacks on each real NIC"/>

                <Button Content="{Binding ViewModeText, Mode=OneWay}" Width="104" Margin="0,0,8,0"
                        Click="CycleView_Click"
                        ToolTip="Cycle bars → stream → widget"/>

                <!-- Flow speed only means anything where a ribbon is drawn. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                            Visibility="{Binding Mode, Converter={StaticResource ModeVis},
                                ConverterParameter=Stream|Widget}">
                    <TextBlock Text="Flow" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource FgDim}"/>
                    <Slider Width="90" Minimum="15" Maximum="200" VerticalAlignment="Center"
                            Value="{Binding StreamSpeed, Mode=TwoWay}"
                            ToolTip="Scroll speed of the stream, in pixels per second"/>
                </StackPanel>

                <Button x:Name="PauseButton" Content="Pause" Width="72" Margin="0,0,8,0"
                        Padding="0,3" Click="PauseButton_Click"/>
                <Button Content="Reset totals" Padding="10,3" Click="ResetButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- Interface list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="14,12,14,0"
                      Visibility="{Binding Mode, Converter={StaticResource ModeVis}, ConverterParameter=!Widget}">
            <Grid>
                <ItemsControl x:Name="InterfaceList" ItemsSource="{Binding Interfaces}"
                              ItemTemplate="{StaticResource InterfaceTemplate}"
                              AllowDrop="True" Background="Transparent"
                              PreviewMouseLeftButtonDown="InterfaceList_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="InterfaceList_PreviewMouseMove"
                              DragOver="InterfaceList_DragOver"
                              DragLeave="InterfaceList_DragLeave"
                              Drop="InterfaceList_Drop"/>
                <TextBlock Text="No matching network interfaces." Margin="0,24,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource FgDim}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Interfaces.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </ScrollViewer>

        <!-- Aggregate footer -->
        <Border Grid.Row="4" Background="{StaticResource PanelAlt}" Padding="14,7"
                BorderBrush="#2C3440" BorderThickness="0,1,0,0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Visibility="{Binding Mode, Converter={StaticResource ModeVis}, ConverterParameter=!Widget}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource FgDim}" FontSize="11"
                           VerticalAlignment="Center">
                    <Run Text="interval"/>
                    <Run Text="{Binding IntervalText, Mode=OneWay}" Foreground="{StaticResource Accent}"/>
                    <Run Text="· log scale, peak hold"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ALL IN" FontSize="11" FontWeight="Bold" Foreground="#3AD17E"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding AggregateInText, Mode=OneWay}" FontFamily="Consolas"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Text="ALL OUT" FontSize="11" FontWeight="Bold" Foreground="#3AC6E8"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding AggregateOutText, Mode=OneWay}" FontFamily="Consolas"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--
            Widget mode: spans every row so the window shrinks to just this panel once the
            chrome above collapses. Drag anywhere to move it, double-click to move on.
        -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="{StaticResource Bg}"
                BorderBrush="#3C4657" BorderThickness="1" Padding="10,8"
                MouseLeftButtonDown="Widget_MouseLeftButtonDown"
                Visibility="{Binding Mode, Converter={StaticResource ModeVis}, ConverterParameter=Widget}">
            <StackPanel>
                <DockPanel Margin="0,0,0,7">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AggregateInText, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="11" Foreground="#3AD17E"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="j0kers" FontWeight="Bold" FontSize="11"
                               Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                               ToolTip="Double-click to leave widget mode"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Interfaces}"
                              ItemTemplate="{StaticResource WidgetTemplate}"/>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
