<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK projection, for the WinRT per-app network usage API. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon: WPF has no system-tray primitive of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NetAnalyzer</AssemblyName>
    <RootNamespace>NetAnalyzer</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Bumped by 0.01 per commit by .githooks/pre-commit; do not edit by hand. -->
    <Version>1.55</Version>
    <!-- Publish as one exe: the app is run from a copy of NetAnalyzer.exe alone. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Enabling WinForms pulls these in as global usings, which makes Color, Point and
      Application ambiguous against their WPF counterparts. TrayIcon.cs imports them locally.
    -->
    <Using Remove="System.Windows.Forms"/>
    <Using Remove="System.Drawing"/>

    <!--
      Embedded rather than copied beside the exe: the tray loads the 16px frame at runtime, and
      a published single-file build should not depend on a loose icon travelling with it.
    -->
    <EmbeddedResource Include="app.ico"/>
  </ItemGroup>

  <!--
    The exe is launched from the desktop dev folder, not from publish/. Copy it there after every
    publish so a rebuild is what actually runs next; skipped if the folder is not present.
  -->
  <Target Name="CopyToDevFolder" AfterTargets="Publish">
    <PropertyGroup>
      <DevFolder>$(USERPROFILE)\OneDrive\Desktop\j0ker Dev</DevFolder>
    </PropertyGroup>
    <Copy Condition="Exists('$(DevFolder)')"
          SourceFiles="$(PublishDir)NetAnalyzer.exe"
          DestinationFolder="$(DevFolder)" ContinueOnError="true"/>
  </Target>

</Project>
