<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon: WPF has no system-tray primitive of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NetAnalyzer</AssemblyName>
    <RootNamespace>NetAnalyzer</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Enabling WinForms pulls these in as global usings, which makes Color, Point and
      Application ambiguous against their WPF counterparts. TrayIcon.cs imports them locally.
    -->
    <Using Remove="System.Windows.Forms"/>
    <Using Remove="System.Drawing"/>

    <!-- Also copied out so the tray can load the 16px frame at runtime. -->
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
