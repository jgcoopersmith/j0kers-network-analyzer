#!/bin/sh
# Bumps <Version> in NetAnalyzer.csproj by 0.01 on every commit, so each commit
# ships a unique, increasing version (shown in the lower-right corner).
# Enabled via: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 0

ver=$(sed -n 's/.*<Version>\([0-9][0-9]*\.[0-9][0-9]*\)<\/Version>.*/\1/p' NetAnalyzer.csproj)
[ -z "$ver" ] && exit 0

major=${ver%%.*}
minor=${ver#*.}
# Force base-10: "08" would otherwise be read as octal.
minor=$((10#$minor + 1))
if [ "$minor" -ge 100 ]; then major=$((major + 1)); minor=0; fi
new=$(printf '%d.%02d' "$major" "$minor")

sed -i "s|<Version>$ver</Version>|<Version>$new</Version>|" NetAnalyzer.csproj
git add NetAnalyzer.csproj
echo "pre-commit: version $ver -> $new"
